@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="dashboard-header mb-4">
        <div>
            <h1 class="fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-muted mb-0">
                Welcome back, Admin! Manage your store from here.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-primary">
            <i class="bi bi-shop"></i>
            View Store
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <h6>Total Products</h6>
                    <h2>@Model.TotalProducts</h2>
                    <small>Products in store</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-success">
                    <i class="bi bi-cart-check"></i>
                </div>

                <div>
                    <h6>Total Orders</h6>
                    <h2>@Model.TotalOrders</h2>
                    <small>Orders received</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-warning">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <h6>Total Customers</h6>
                    <h2>@Model.TotalCustomers</h2>
                    <small>Registered customers</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-danger">
                    <i class="bi bi-currency-dollar"></i>
                </div>

                <div>
                    <h6>Total Revenue</h6>
                    <h2>@Model.TotalRevenue.ToString("C2")</h2>
                    <small>Total sales revenue</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Management Cards -->
    <div class="row g-4">

        <div class="col-md-6 col-xl-4">
            <div class="management-card">
                <div class="management-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h4>Manage Products</h4>

                <p>
                    Add new products, edit existing products,
                    or remove products from your store.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary">
                    Manage Products
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="management-card">
                <div class="management-icon">
                    <i class="bi bi-cart-check"></i>
                </div>

                <h4>Manage Orders</h4>

                <p>
                    View customer orders and update
                    order statuses easily.
                </p>

                <a asp-controller="Order"
                   asp-action="ManageOrders"
                   class="btn btn-success">
                    Manage Orders
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="management-card">
                <div class="management-icon">
                    <i class="bi bi-house-door"></i>
                </div>

                <h4>Store Homepage</h4>

                <p>
                    Return to the store homepage
                    and browse your products.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-dark">
                    Visit Store
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>

</div>

<style>
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

        .dashboard-header h1 {
            color: #212529;
        }

    .stat-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 25px;
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 145px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

    .stat-icon {
        width: 65px;
        height: 65px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
        flex-shrink: 0;
    }

    .stat-card h6 {
        color: #6c757d;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .stat-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 5px;
        color: #212529;
    }

    .stat-card small {
        color: #8a8a8a;
    }

    .management-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        height: 100%;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
        transition: all 0.3s ease;
    }

        .management-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

    .management-icon {
        width: 60px;
        height: 60px;
        background: #eef4ff;
        color: #0d6efd;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 20px;
    }

    .management-card h4 {
        font-weight: 700;
        margin-bottom: 12px;
    }

    .management-card p {
        color: #6c757d;
        min-height: 70px;
        line-height: 1.7;
    }

    .management-card .btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .dashboard-header h1 {
            font-size: 28px;
        }

        .stat-card {
            padding: 20px;
        }

        .management-card {
            padding: 25px;
        }
    }
</style>