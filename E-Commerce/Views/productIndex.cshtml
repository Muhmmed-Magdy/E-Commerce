```cshtml
@model List<E_Commerce.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="text-primary fw-bold">OUR STORE</span>
            <h1 class="fw-bold mb-1">Products</h1>
            <p class="text-muted">Discover our latest products</p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            + Add Product
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-3">
            <form asp-action="Search" method="get">
                <div class="input-group">
                    <input type="text"
                           name="search"
                           class="form-control form-control-lg border-0"
                           placeholder="Search products..." />

                    <button type="submit"
                            class="btn btn-dark px-4">
                        Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <div style="height:220px; background:#f5f6f8;
                            display:flex; align-items:center;
                            justify-content:center;">

                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@product.ImagePath"
                                     alt="@product.Title"
                                     style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted">No Image</span>
                            }

                        </div>

                        <div class="card-body d-flex flex-column p-4">

                            <span class="badge bg-primary-subtle text-primary align-self-start mb-2">
                                @product.Category?.Name
                            </span>

                            <h5 class="fw-bold">@product.Title</h5>

                            <p class="text-muted small flex-grow-1">
                                @product.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="fs-5 fw-bold text-primary">
                                    $@product.Price
                                </span>

                                @if (product.Quantity > 0)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }

                            </div>

                            <div class="d-flex gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-outline-dark flex-grow-1">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-outline-primary">
                                    Edit
                                </a>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <div class="mb-3" style="font-size:60px;">
                🛍️
            </div>

            <h3 class="fw-bold">No Products Yet</h3>

            <p class="text-muted">
                Start by adding your first product.
            </p>

            <a asp-action="Create" class="btn btn-primary px-4">
                Add Product
            </a>

        </div>
    }

</div>
```
