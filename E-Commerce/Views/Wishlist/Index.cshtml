@model IEnumerable<E_Commerce.Models.Wishlist>

@{
    ViewData["Title"] = "Wishlist";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">

        <div>
            <span class="text-danger fw-bold">YOUR FAVORITES</span>

            <h1 class="fw-bold mb-1">
                My Wishlist
            </h1>

            <p class="text-muted mb-0">
                Products you saved for later
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-dark">

            <i class="bi bi-arrow-left me-1"></i>
            Continue Shopping
        </a>

    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty Wishlist -->
        <div class="empty-wishlist text-center py-5">

            <div class="empty-icon mb-3">
                <i class="bi bi-heart"></i>
            </div>

            <h3 class="fw-bold">
                Your Wishlist is Empty
            </h3>

            <p class="text-muted mb-4">
                You haven't added any products to your wishlist yet.
            </p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary px-4">

                <i class="bi bi-shop me-1"></i>
                Explore Products
            </a>

        </div>
    }
    else
    {
        <!-- Wishlist Products -->
        <div class="row g-4">

            @foreach (var item in Model)
            {
                if (item.Product != null)
                {
                    <div class="col-md-6 col-lg-4 col-xl-3">

                        <div class="card wishlist-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                            <!-- Product Image -->
                            <div class="product-image">

                                @if (!string.IsNullOrWhiteSpace(item.Product.ImagePath))
                                {
                                    <img src="@item.Product.ImagePath"
                                         alt="@item.Product.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="no-image">
                                        <i class="bi bi-image"></i>
                                        <span>No Image</span>
                                    </div>
                                }

                                <!-- Wishlist Badge -->
                                <span class="wishlist-badge">
                                    <i class="bi bi-heart-fill"></i>
                                </span>

                            </div>

                            <!-- Product Details -->
                            <div class="card-body d-flex flex-column p-4">

                                <h5 class="card-title fw-bold product-title">
                                    @item.Product.Title
                                </h5>

                                <p class="text-muted small flex-grow-1">
                                    @(string.IsNullOrWhiteSpace(item.Product.Description)
                                        ? "No description available."
                                        : item.Product.Description)
                                </p>

                                <!-- Price -->
                                <div class="mb-3">
                                    <span class="fs-5 fw-bold text-primary">
                                        @item.Product.Price.ToString("C2")
                                    </span>
                                </div>

                                <!-- Actions -->
                                <div class="d-flex gap-2 mb-2">

                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-outline-dark flex-grow-1">

                                        <i class="bi bi-eye me-1"></i>
                                        Details
                                    </a>

                                    @if (item.Product.Quantity > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="AddToCart"
                                              method="post"
                                              class="flex-grow-1">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@item.ProductId" />

                                            <input type="hidden"
                                                   name="quantity"
                                                   value="1" />

                                            <button type="submit"
                                                    class="btn btn-primary w-100">

                                                <i class="bi bi-cart-plus me-1"></i>
                                                Add
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-secondary flex-grow-1"
                                                disabled>

                                            Out of Stock
                                        </button>
                                    }

                                </div>

                                <!-- Remove From Wishlist -->
                                <form asp-controller="Wishlist"
                                      asp-action="RemoveFromWishlist"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="wishlistId"
                                           value="@item.WishlistId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger w-100">

                                        <i class="bi bi-trash me-1"></i>
                                        Remove
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>
    }

</div>

<style>
    .wishlist-card {
        transition: all 0.3s ease;
    }

        .wishlist-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12) !important;
        }

    .product-image {
        height: 220px;
        background: #f5f6f8;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .wishlist-card:hover .product-image img {
        transform: scale(1.05);
    }

    .wishlist-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #dc3545;
        border-radius: 50%;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
    }

    .no-image {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #9ca3af;
        font-size: 14px;
    }

        .no-image i {
            font-size: 42px;
        }

    .product-title {
        min-height: 48px;
        line-height: 1.5;
    }

    .wishlist-card .btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .empty-wishlist {
        padding: 80px 20px;
    }

    .empty-icon {
        font-size: 75px;
        color: #dc3545;
    }

    @@media (max-width: 576px) {
        .product-image {
            height: 240px;
        }

        .product-title {
            min-height: auto;
        }
    }
</style>