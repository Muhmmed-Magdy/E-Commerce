@model E_Commerce.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">Category Details</h2>
        <p class="text-muted">View category information and products</p>
    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3 class="fw-bold">@Model.Name</h3>

            <p class="text-muted mt-3">
                @(string.IsNullOrEmpty(Model.Description)
                    ? "No description available."
                    : Model.Description)
            </p>

            <div class="mt-3">
                <span class="badge bg-primary">
                    @(Model.Products?.Count ?? 0) Products
                </span>
            </div>

        </div>

    </div>

    <h4 class="fw-bold mb-3">Products in this Category</h4>

    @if (Model.Products == null || Model.Products.Count == 0)
    {
        <div class="alert alert-info">
            No products found in this category.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var product in Model.Products)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                @product.Title
                            </h5>

                            <p class="text-success fw-bold">
                                @product.Price.ToString("C")
                            </p>

                            <p class="text-muted">
                                Quantity: @product.Quantity
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">

        <a asp-action="Edit"
           asp-route-id="@Model.CategoryId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Categories
        </a>

    </div>

</div>
