<div id="chatbot">

    <!-- Floating Button -->
    <button id="chatbot-toggle"
            type="button"
            aria-label="Open AI Assistant">

        <i class="bi bi-robot"></i>
    </button>


    <!-- Chat Window -->
    <div id="chatbot-window">

        <!-- Header -->
        <div class="chatbot-header">

            <div>
                <strong>Store Assistant</strong>
                <small>
                    <span class="status-dot"></span>
                    Online
                </small>
            </div>

            <button id="chatbot-close"
                    type="button"
                    aria-label="Close chatbot">

                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <!-- Messages -->
        <div id="chatbot-messages">

            <div class="chat-message bot-message">
                <div class="message-avatar">
                    <i class="bi bi-robot"></i>
                </div>

                <div class="message-content">
                    Hi 👋 I'm your AI shopping assistant.
                    How can I help you?
                </div>
            </div>

        </div>


        <!-- Input -->
        <div class="chatbot-input">

            <input type="text"
                   id="chatbot-input"
                   placeholder="Ask me something..."
                   autocomplete="off" />

            <button type="button"
                    id="chatbot-send"
                    aria-label="Send message">

                <i class="bi bi-send-fill"></i>
            </button>

        </div>

    </div>

</div>


<style>

    #chatbot {
        position: fixed;
        right: 25px;
        bottom: 25px;
        z-index: 9999;
        font-family: inherit;
    }

    /* Floating Button */
    #chatbot-toggle {
        width: 60px;
        height: 60px;
        border: none;
        border-radius: 50%;
        background: #0d6efd;
        color: white;
        font-size: 25px;
        cursor: pointer;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
    }

        #chatbot-toggle:hover {
            transform: scale(1.08);
        }


    /* Chat Window */
    #chatbot-window {
        position: absolute;
        right: 0;
        bottom: 75px;
        width: 360px;
        height: 500px;
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.2);
        display: none;
        flex-direction: column;
    }

        #chatbot-window.active {
            display: flex;
        }


    /* Header */
    .chatbot-header {
        background: #0d6efd;
        color: white;
        padding: 15px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .chatbot-header strong {
            display: block;
            font-size: 16px;
        }

        .chatbot-header small {
            font-size: 12px;
            opacity: 0.9;
        }

    .status-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        background: #28a745;
        border-radius: 50%;
        margin-right: 4px;
    }

    #chatbot-close {
        border: none;
        background: transparent;
        color: white;
        font-size: 18px;
        cursor: pointer;
    }


    /* Messages */
    #chatbot-messages {
        flex: 1;
        padding: 15px;
        overflow-y: auto;
        background: #f8f9fa;
    }

    .chat-message {
        display: flex;
        gap: 8px;
        margin-bottom: 14px;
    }

    .user-message {
        justify-content: flex-end;
    }

    .message-avatar {
        width: 30px;
        height: 30px;
        min-width: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #0d6efd;
        color: white;
    }

    .message-content {
        max-width: 82%;
        padding: 11px 14px;
        border-radius: 14px;
        font-size: 14px;
        line-height: 1.6;
        background: white;
        color: #212529;
        white-space: pre-wrap;
        word-break: break-word;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .bot-message .message-content {
        border-top-left-radius: 4px;
    }

    .user-message .message-content {
        background: #0d6efd;
        color: white;
        border-top-right-radius: 4px;
    }

    /* Input */
    .chatbot-input {
        display: flex;
        gap: 8px;
        padding: 12px;
        background: white;
        border-top: 1px solid #eee;
    }

    #chatbot-input {
        flex: 1;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
    }

        #chatbot-input:focus {
            border-color: #0d6efd;
        }

    #chatbot-send {
        width: 42px;
        border: none;
        border-radius: 10px;
        background: #0d6efd;
        color: white;
        cursor: pointer;
    }

        #chatbot-send:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }


    /* Mobile */
    @@media (max-width: 576px) {

        #chatbot {
            right: 15px;
            bottom: 15px;
        }

        #chatbot-window {
            width: calc(100vw - 30px);
            height: 70vh;
            right: -2px;
        }
    }

</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const toggle = document.getElementById("chatbot-toggle");
        const close = document.getElementById("chatbot-close");

        const windowElement =
            document.getElementById("chatbot-window");

        const input =
            document.getElementById("chatbot-input");

        const sendButton =
            document.getElementById("chatbot-send");

        const messages =
            document.getElementById("chatbot-messages");


        // ==========================================
        // Open chatbot
        // ==========================================

        toggle.addEventListener("click", function () {

            windowElement.classList.add("active");

            input.focus();

        });


        // ==========================================
        // Close chatbot
        // ==========================================

        close.addEventListener("click", function () {

            windowElement.classList.remove("active");

        });


        // ==========================================
        // Send Message
        // ==========================================

        async function sendMessage() {

            const message = input.value.trim();

            if (!message) {
                return;
            }


            // Add user message
            addMessage(message, "user");


            // Clear input
            input.value = "";


            // Disable button
            sendButton.disabled = true;


            // Loading message
            const loadingMessage =
                addMessage("Thinking...", "bot");


            try {

                console.log("Sending message:", message);


                const response = await fetch("/Chat/Send", {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded"
                    },

                    body:
                        "message=" +
                        encodeURIComponent(message)

                });


                console.log(
                    "HTTP Status:",
                    response.status
                );


                // Get raw response first
                const responseText =
                    await response.text();


                console.log(
                    "Server Response:",
                    responseText
                );


                // Remove loading
                loadingMessage.remove();


                // Try to parse JSON
                let data;

                try {

                    data = JSON.parse(responseText);

                }
                catch (jsonError) {

                    throw new Error(
                        "Server returned an invalid response: "
                        + responseText
                    );

                }


                // Check HTTP status
                if (!response.ok) {

                    throw new Error(
                        data.message ||
                        "Server returned an error. Status: "
                        + response.status
                    );

                }


                // Successful response
                if (data.success) {

                    addMessage(
                        data.message,
                        "bot"
                    );

                }
                else {

                    addMessage(
                        data.message ||
                        "Something went wrong.",
                        "bot"
                    );

                }

            }
            catch (error) {

                loadingMessage.remove();


                console.error(
                    "CHATBOT ERROR:",
                    error
                );


                addMessage(
                    "❌ Error: " + error.message,
                    "bot"
                );

            }
            finally {

                sendButton.disabled = false;

                input.focus();

            }

        }


        // ==========================================
        // Add Message
        // ==========================================

        function addMessage(text, type) {

            const messageDiv =
                document.createElement("div");


            messageDiv.className =
                "chat-message " +
                (type === "user"
                    ? "user-message"
                    : "bot-message");


            if (type === "bot") {

                messageDiv.innerHTML = `
                    <div class="message-avatar">
                        <i class="bi bi-robot"></i>
                    </div>

                    <div class="message-content">
                        ${escapeHtml(text)}
                    </div>
                `;

            }
            else {

                messageDiv.innerHTML = `
                    <div class="message-content">
                        ${escapeHtml(text)}
                    </div>
                `;

            }


            messages.appendChild(messageDiv);


            messages.scrollTop =
                messages.scrollHeight;


            return messageDiv;

        }


        // ==========================================
        // Prevent HTML Injection
        // ==========================================

        function escapeHtml(text) {

            const div =
                document.createElement("div");

            div.textContent = text;

            return div.innerHTML;

        }


        // ==========================================
        // Send Button
        // ==========================================

        sendButton.addEventListener(
            "click",
            sendMessage
        );


        // ==========================================
        // Enter Key
        // ==========================================

        input.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    sendMessage();

                }

            }
        );

    });

</script>