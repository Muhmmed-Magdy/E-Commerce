@using Microsoft.AspNetCore.Identity
@using E_Commerce.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - E_Commerce</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/E_Commerce.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background: #f8f9fc;
        }

        .custom-navbar {
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        .brand-logo {
            font-size: 25px;
            font-weight: 800;
            color: #2563eb !important;
            letter-spacing: -1px;
        }

        .nav-link {
            font-weight: 500;
            color: #374151 !important;
            margin: 0 5px;
            transition: 0.2s;
        }

            .nav-link:hover {
                color: #2563eb !important;
            }

        .cart-link {
            background: #eff6ff;
            color: #2563eb !important;
            border-radius: 12px;
            padding: 8px 14px !important;
        }

            .cart-link:hover {
                background: #dbeafe;
            }

        .wishlist-link {
            background: #fff1f2;
            color: #e11d48 !important;
            border-radius: 12px;
            padding: 8px 14px !important;
        }

            .wishlist-link:hover {
                background: #ffe4e6;
                color: #be123c !important;
            }

        .orders-link {
            background: #f0fdf4;
            color: #15803d !important;
            border-radius: 12px;
            padding: 8px 14px !important;
        }

            .orders-link:hover {
                background: #dcfce7;
            }

        .admin-link {
            background: #fff7ed;
            color: #c2410c !important;
            border-radius: 12px;
            padding: 8px 14px !important;
        }

            .admin-link:hover {
                background: #ffedd5;
            }

        .user-badge {
            background: #f3f4f6;
            border-radius: 12px;
            padding: 8px 14px !important;
            white-space: nowrap;
        }

        .login-btn {
            border: 1px solid #2563eb;
            border-radius: 10px;
            color: #2563eb !important;
            padding: 8px 16px !important;
        }

        .register-btn {
            background: #2563eb;
            color: white !important;
            border-radius: 10px;
            padding: 8px 16px !important;
        }

            .register-btn:hover {
                background: #1d4ed8;
                color: white !important;
            }

        footer {
            background: white;
            margin-top: 50px;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg custom-navbar sticky-top">
            <div class="container">

                <a class="navbar-brand brand-logo"
                   asp-controller="Home"
                   asp-action="Index">
                    🛍️ E-Commerce
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                🏠 Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Index">
                                🛍️ Products
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true &&
                        User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link cart-link"
                                   asp-controller="Cart"
                                   asp-action="Index">
                                    🛒 My Cart
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link wishlist-link"
                                   asp-controller="Wishlist"
                                   asp-action="Index">
                                    ❤️ Wishlist
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link orders-link"
                                   asp-controller="Order"
                                   asp-action="MyOrders">
                                    📦 My Orders
                                </a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true &&
                        User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link admin-link"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">
                                    ⚙️ Admin Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Order"
                                   asp-action="ManageOrders">
                                    📋 Manage Orders
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var currentUser = await UserManager.GetUserAsync(User);

                            <li class="nav-item">
                                <span class="nav-link user-badge">
                                    👋 Hello,
                                    @(currentUser is null
                                        ? "User"
                                        : $"{currentUser.FirstName} {currentUser.LastName}")
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="User"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link nav-link">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link login-btn"
                                   asp-controller="User"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link register-btn"
                                   asp-controller="User"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top py-4">
        <div class="container text-center text-muted">

            <div class="mb-2">
                <strong class="text-primary">
                    🛍️ E-Commerce
                </strong>
            </div>

            <div>
                &copy; 2026 - E-Commerce -
                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="text-decoration-none">
                    Privacy
                </a>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <partial name="_Chatbot" />
    @await RenderSectionAsync("Scripts", required: false)

   

</body>
</html>