```cshtml
@model E_Commerce.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            ← Back to Products
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <div class="row g-0">

            <div class="col-lg-6">

                <div style="height:500px; background:#f5f6f8;
                    display:flex; align-items:center;
                    justify-content:center;">

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath"
                             alt="@Model.Title"
                             style="width:100%; height:100%; object-fit:cover;" />
                    }
                    else
                    {
                        <span class="text-muted">No Image Available</span>
                    }

                </div>

            </div>

            <div class="col-lg-6">

                <div class="p-5">

                    <span class="badge bg-primary-subtle text-primary mb-3">
                        @Model.Category?.Name
                    </span>

                    <h1 class="fw-bold mb-3">
                        @Model.Title
                    </h1>

                    <h2 class="text-primary fw-bold mb-4">
                        $@Model.Price
                    </h2>

                    <p class="text-muted mb-4">
                        @Model.Description
                    </p>

                    <div class="border-top border-bottom py-3 mb-4">

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Category</span>
                            <strong>@Model.Category?.Name</strong>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Available Quantity</span>
                            <strong>@Model.Quantity</strong>
                        </div>

                    </div>

                    <div class="d-flex gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.ProductId"
                           class="btn btn-primary px-4">
                            Edit Product
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.ProductId"
                           class="btn btn-outline-danger px-4">
                            Delete
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
```
