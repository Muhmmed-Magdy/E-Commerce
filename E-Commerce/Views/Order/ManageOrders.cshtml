@model IEnumerable<E_Commerce.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Manage Orders 📋</h1>
            <p class="text-muted mb-0">
                View and manage all customer orders
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary rounded-pill px-4">
            ← Admin Dashboard
        </a>
    </div>

    <!-- Summary -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card summary-card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="summary-icon bg-primary-subtle">📦</div>

                    <p class="text-muted mb-1">Total Orders</p>

                    <h2 class="fw-bold mb-0">
                        @Model.Count()
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card summary-card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="summary-icon bg-warning-subtle">⏳</div>

                    <p class="text-muted mb-1">Pending Orders</p>

                    <h2 class="fw-bold mb-0">
                        @Model.Count(o => o.Status == "Pending")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card summary-card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="summary-icon bg-success-subtle">💰</div>

                    <p class="text-muted mb-1">Total Sales</p>

                    <h2 class="fw-bold mb-0">
                        @Model.Sum(o => o.TotalAmount).ToString("C")
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Orders Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-0">
                All Orders
            </h5>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center p-5">
                <div class="display-3 mb-3">📦</div>

                <h4 class="fw-bold">No Orders Found</h4>

                <p class="text-muted mb-0">
                    There are no customer orders yet.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Order #</th>
                            <th class="py-3">Customer</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Total</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Payment</th>
                            <th class="py-3">Change Status</th>
                            <th class="py-3 text-center">Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-primary">
                                    #@order.OrderId
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @(order.User?.FirstName ?? "Unknown")
                                        @(order.User?.LastName ?? "Customer")
                                    </div>

                                    <small class="text-muted">
                                        @order.User?.Email
                                    </small>
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @order.OrderDate.ToLocalTime().ToString("dd MMM yyyy")
                                    </span>
                                    <br />
                                    <small class="text-muted">
                                        @order.OrderDate.ToLocalTime().ToString("hh:mm tt")
                                    </small>
                                </td>

                                <td class="fw-bold">
                                    @order.TotalAmount.ToString("C")
                                </td>

                                <td>
                                    @if (order.Status == "Pending")
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                                            ⏳ Pending
                                        </span>
                                    }
                                    else if (order.Status == "Confirmed")
                                    {
                                        <span class="badge rounded-pill bg-info text-dark px-3 py-2">
                                            ✓ Confirmed
                                        </span>
                                    }
                                    else if (order.Status == "Shipped")
                                    {
                                        <span class="badge rounded-pill bg-primary px-3 py-2">
                                            🚚 Shipped
                                        </span>
                                    }
                                    else if (order.Status == "Delivered")
                                    {
                                        <span class="badge rounded-pill bg-success px-3 py-2">
                                            ✓ Delivered
                                        </span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="badge rounded-pill bg-danger px-3 py-2">
                                            ✕ Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            @order.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (order.PaymentStatus == "Paid")
                                    {
                                        <span class="badge rounded-pill bg-success px-3 py-2">
                                            ✓ Paid
                                        </span>
                                    }
                                    else if (order.PaymentStatus == "Pending")
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                                            ⏳ Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            @order.PaymentStatus
                                        </span>
                                    }
                                </td>

                                <td>
                                    <form asp-action="UpdateStatus"
                                          method="post"
                                          class="d-flex gap-2 status-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@order.OrderId" />

                                        <select name="status"
                                                class="form-select form-select-sm status-select">

                                            @if (order.Status == "Pending")
                                            {
                                                <option value="Pending" selected>Pending</option>
                                            }
                                            else
                                            {
                                                <option value="Pending">Pending</option>
                                            }

                                            @if (order.Status == "Confirmed")
                                            {
                                                <option value="Confirmed" selected>Confirmed</option>
                                            }
                                            else
                                            {
                                                <option value="Confirmed">Confirmed</option>
                                            }

                                            @if (order.Status == "Shipped")
                                            {
                                                <option value="Shipped" selected>Shipped</option>
                                            }
                                            else
                                            {
                                                <option value="Shipped">Shipped</option>
                                            }

                                            @if (order.Status == "Delivered")
                                            {
                                                <option value="Delivered" selected>Delivered</option>
                                            }
                                            else
                                            {
                                                <option value="Delivered">Delivered</option>
                                            }

                                            @if (order.Status == "Cancelled")
                                            {
                                                <option value="Cancelled" selected>Cancelled</option>
                                            }
                                            else
                                            {
                                                <option value="Cancelled">Cancelled</option>
                                            }

                                        </select>

                                        <button type="submit"
                                                class="btn btn-primary btn-sm rounded-pill px-3">
                                            Update
                                        </button>
                                    </form>
                                </td>

                                <td class="text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@order.OrderId"
                                       class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        View →
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>

</div>

<style>
    .summary-card {
        transition: 0.2s ease;
    }

        .summary-card:hover {
            transform: translateY(-3px);
        }

    .summary-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 24px;
        margin-bottom: 15px;
    }

    .table th {
        font-size: 13px;
        font-weight: 700;
        color: #374151;
        white-space: nowrap;
    }

    .table td {
        font-size: 14px;
        white-space: nowrap;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .badge {
        font-size: 12px;
        font-weight: 600;
    }

    .status-form {
        min-width: 220px;
    }

    .status-select {
        min-width: 125px;
    }

    .btn {
        font-weight: 600;
    }
</style>