@model E_Commerce.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<h1>Order #@Model.OrderId</h1>

<div class="mb-4">
    <p><strong>Date:</strong> @Model.OrderDate.ToLocalTime().ToString("g")</p>
    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
    <p><strong>Payment Status:</strong> @Model.PaymentStatus</p>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price at Purchase</th>
            <th>Quantity</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.OrderItems)
    {
        <tr>
            <td>@item.Product.Title</td>
            <td>@item.Price.ToString("C")</td>
            <td>@item.Quantity</td>
            <td>@((item.Price * item.Quantity).ToString("C"))</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th>@Model.TotalAmount.ToString("C")</th>
        </tr>
    </tfoot>
</table>

<a asp-controller="Order"
   asp-action="MyOrders"
   class="btn btn-secondary">
    Back to My Orders
</a>
