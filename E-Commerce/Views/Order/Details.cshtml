@model E_Commerce.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1">
                Order #@Model.OrderId 📦
            </h1>

            <p class="text-muted mb-0">
                View your order details and shipping information
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Order"
               asp-action="ManageOrders"
               class="btn btn-outline-secondary rounded-pill px-4">
                ← Back to Manage Orders
            </a>
        }
        else
        {
            <a asp-controller="Order"
               asp-action="MyOrders"
               class="btn btn-outline-secondary rounded-pill px-4">
                ← Back to My Orders
            </a>
        }
    </div>

    <!-- Order Information -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-0">
                Order Information
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-3">
                    <div class="info-label">Order Date</div>

                    <div class="info-value">
                        @Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy")
                    </div>

                    <small class="text-muted">
                        @Model.OrderDate.ToLocalTime().ToString("hh:mm tt")
                    </small>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Order Status</div>

                    @if (Model.Status == "Pending")
                    {
                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                            ⏳ Pending
                        </span>
                    }
                    else if (Model.Status == "Confirmed")
                    {
                        <span class="badge rounded-pill bg-info text-dark px-3 py-2">
                            ✓ Confirmed
                        </span>
                    }
                    else if (Model.Status == "Shipped")
                    {
                        <span class="badge rounded-pill bg-primary px-3 py-2">
                            🚚 Shipped
                        </span>
                    }
                    else if (Model.Status == "Delivered")
                    {
                        <span class="badge rounded-pill bg-success px-3 py-2">
                            ✓ Delivered
                        </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge rounded-pill bg-danger px-3 py-2">
                            ✕ Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                            @Model.Status
                        </span>
                    }
                </div>

                <div class="col-md-3">
                    <div class="info-label">Payment Method</div>

                    <div class="info-value">
                        💵 @Model.PaymentMethod
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Payment Status</div>

                    @if (Model.PaymentStatus == "Paid")
                    {
                        <span class="badge rounded-pill bg-success px-3 py-2">
                            ✓ Paid
                        </span>
                    }
                    else if (Model.PaymentStatus == "Pending")
                    {
                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                            ⏳ Pending
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                            @Model.PaymentStatus
                        </span>
                    }
                </div>

            </div>

        </div>
    </div>

    <!-- Shipping Address -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-0">
                Shipping Address 📍
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="info-label">
                        Full Name
                    </div>

                    <div class="info-value">
                        @Model.FullName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">
                        Phone Number
                    </div>

                    <div class="info-value">
                        @Model.Phone
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">
                        City
                    </div>

                    <div class="info-value">
                        @Model.City
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-label">
                        Postal Code
                    </div>

                    <div class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.PostalCode)
                            ? "Not provided"
                            : Model.PostalCode)
                    </div>
                </div>

                <div class="col-12">
                    <div class="info-label">
                        Address
                    </div>

                    <div class="info-value">
                        @Model.Address
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Products -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-0">
                Order Items 🛍️
            </h5>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">Product</th>
                        <th class="py-3">Price at Purchase</th>
                        <th class="py-3">Quantity</th>
                        <th class="py-3">Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td class="px-4">
                                <div class="fw-bold">
                                    @item.Product.Title
                                </div>
                            </td>

                            <td>
                                @item.Price.ToString("C")
                            </td>

                            <td>
                                <span class="badge rounded-pill bg-light text-dark px-3 py-2">
                                    @item.Quantity
                                </span>
                            </td>

                            <td class="fw-bold text-primary">
                                @((item.Price * item.Quantity).ToString("C"))
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr class="table-light">

                        <th colspan="3" class="text-end px-4 py-4">
                            Grand Total
                        </th>

                        <th class="text-primary fs-5 py-4">
                            @Model.TotalAmount.ToString("C")
                        </th>

                    </tr>
                </tfoot>

            </table>

        </div>
    </div>

    <!-- Bottom Action -->
    <div class="text-end mt-4">

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-primary rounded-pill px-4">
            Continue Shopping 🛍️
        </a>

    </div>

</div>

<style>
    .card {
        border-radius: 20px !important;
    }

    .info-label {
        color: #6b7280;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .info-value {
        color: #111827;
        font-size: 16px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .table th {
        font-size: 14px;
        font-weight: 700;
        color: #374151;
        white-space: nowrap;
    }

    .table td {
        font-size: 14px;
        white-space: nowrap;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .badge {
        font-size: 12px;
        font-weight: 600;
    }

    .btn {
        font-weight: 600;
    }
</style>