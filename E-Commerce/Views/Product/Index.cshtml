@model List<E_Commerce.Models.Product>

@{
    ViewData["Title"] = "Products";

    var wishlistProductIds =
        ViewBag.WishlistProductIds as HashSet<int>
        ?? new HashSet<int>();

    var selectedCategoryId =
        ViewBag.CategoryId as int?;

    var searchValue =
        ViewBag.Search as string ?? "";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <span class="text-primary fw-bold">OUR STORE</span>
            <h1 class="fw-bold mb-1">Products</h1>
            <p class="text-muted mb-0">
                Discover our latest products
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2 flex-wrap">

                <a asp-controller="Category"
                   asp-action="Index"
                   class="btn btn-outline-primary px-4 py-2">

                    <i class="bi bi-grid me-1"></i>
                    Categories
                </a>

                <a asp-controller="Product"
                   asp-action="Create"
                   class="btn btn-primary px-4 py-2">

                    <i class="bi bi-plus-lg me-1"></i>
                    Add Product
                </a>

            </div>
        }
    </div>

    <!-- Search and Category Filter -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-3">

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get">

                <div class="row g-2">

                    <!-- Search Input -->
                    <div class="col-md-6">
                        <input type="text"
                               name="search"
                               value="@searchValue"
                               class="form-control form-control-lg"
                               placeholder="Search products..."
                               aria-label="Search products" />
                    </div>

                    <!-- Category Dropdown -->
                    <div class="col-md-4">
                        <select name="categoryId"
                                class="form-select form-select-lg">

                            <option value="">
                                All Categories
                            </option>

                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    if (selectedCategoryId.HasValue &&
                                    selectedCategoryId.Value == category.CategoryId)
                                    {
                                        <option value="@category.CategoryId" selected>
                                            @category.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.CategoryId">
                                            @category.Name
                                        </option>
                                    }
                                }
                            }

                        </select>
                    </div>

                    <!-- Search Button -->
                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-dark btn-lg w-100">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Products -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">

                    <div class="card product-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <!-- Product Image -->
                        <div class="product-image">

                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@product.ImagePath"
                                     alt="@product.Title"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="no-image">
                                    <i class="bi bi-image"></i>
                                    <span>No Image</span>
                                </div>
                            }

                        </div>

                        <!-- Product Details -->
                        <div class="card-body d-flex flex-column p-4">

                            <!-- Category -->
                            <span class="badge bg-primary-subtle text-primary align-self-start mb-2">
                                @(product.Category?.Name ?? "Uncategorized")
                            </span>

                            <!-- Title -->
                            <h5 class="fw-bold product-title">
                                @product.Title
                            </h5>

                            <!-- Description -->
                            <p class="text-muted small product-description flex-grow-1">
                                @product.Description
                            </p>

                            <!-- Price and Stock -->
                            <div class="d-flex justify-content-between align-items-center mb-3 gap-2">

                                <span class="fs-5 fw-bold text-primary">
                                    @product.Price.ToString("C2")
                                </span>

                                @if (product.Quantity > 0)
                                {
                                    <span class="badge bg-success">
                                        In Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Out of Stock
                                    </span>
                                }

                            </div>

                            <!-- Customer Actions -->
                            <div class="d-flex gap-2 mb-2">

                                <!-- Details -->
                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-outline-dark flex-grow-1">

                                    <i class="bi bi-eye me-1"></i>
                                    Details
                                </a>

                                <!-- Add To Cart -->
                                @if (User.IsInRole("Customer") && product.Quantity > 0)
                                {
                                    <form asp-controller="Cart"
                                          asp-action="AddToCart"
                                          method="post"
                                          class="flex-grow-1">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="productId"
                                               value="@product.ProductId" />

                                        <input type="hidden"
                                               name="quantity"
                                               value="1" />

                                        <button type="submit"
                                                class="btn btn-primary w-100">

                                            <i class="bi bi-cart-plus me-1"></i>
                                            Add
                                        </button>

                                    </form>
                                }
                                else if (User.IsInRole("Customer"))
                                {
                                    <button type="button"
                                            class="btn btn-secondary flex-grow-1"
                                            disabled>
                                        Out of Stock
                                    </button>
                                }

                            </div>

                            <!-- Wishlist -->
                            @if (User.IsInRole("Customer"))
                            {
                                var isInWishlist =
                                wishlistProductIds.Contains(product.ProductId);

                                <form asp-controller="Wishlist"
                                      asp-action="AddToWishlist"
                                      method="post"
                                      class="mb-3">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.ProductId" />

                                    <button type="submit"
                                            class="btn @(isInWishlist ? "btn-danger" : "btn-outline-danger") w-100">

                                        <i class="bi @(isInWishlist ? "bi-heart-fill" : "bi-heart") me-1"></i>

                                        @(isInWishlist
                                            ? "Added to Wishlist"
                                            : "Add to Wishlist")

                                    </button>

                                </form>
                            }

                            <!-- Admin Actions -->
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-2">

                                    <a asp-controller="Product"
                                       asp-action="Edit"
                                       asp-route-id="@product.ProductId"
                                       class="btn btn-outline-primary flex-grow-1">

                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit
                                    </a>

                                    <a asp-controller="Product"
                                       asp-action="Delete"
                                       asp-route-id="@product.ProductId"
                                       class="btn btn-outline-danger">

                                        <i class="bi bi-trash me-1"></i>
                                        Delete
                                    </a>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <div class="empty-icon mb-3">
                <i class="bi bi-bag-x"></i>
            </div>

            <h3 class="fw-bold">
                No Products Found
            </h3>

            <p class="text-muted">
                Try another search or category.
            </p>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Product"
                   asp-action="Create"
                   class="btn btn-primary px-4">

                    <i class="bi bi-plus-lg me-1"></i>
                    Add Product
                </a>
            }

        </div>
    }

</div>

<style>
    .product-card {
        transition: all 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12) !important;
        }

    .product-image {
        height: 220px;
        background: #f5f6f8;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .no-image {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #9ca3af;
        font-size: 14px;
    }

        .no-image i {
            font-size: 42px;
        }

    .product-title {
        min-height: 48px;
        line-height: 1.5;
    }

    .product-description {
        min-height: 65px;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-card .btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .empty-icon {
        font-size: 65px;
        color: #6c757d;
    }

    @@media (max-width: 576px) {
        .product-image {
            height: 240px;
        }

        .product-title {
            min-height: auto;
        }

        .product-description {
            min-height: auto;
        }
    }
</style>