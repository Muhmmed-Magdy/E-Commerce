@model E_Commerce.ViewModels.EditProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <span class="text-primary fw-bold">PRODUCT MANAGEMENT</span>

        <h1 class="fw-bold">Edit Product</h1>

        <p class="text-muted">
            Update product information
        </p>
    </div>

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-body p-5">

            <form asp-action="Edit"
                  asp-controller="Product"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ProductId" />

                <input type="hidden" asp-for="ImagePath" />

                <div asp-validation-summary="All"
                     class="alert alert-danger">
                </div>

                <div class="row g-4">

                    <!-- Product Name -->
                    <div class="col-md-6">

                        <label asp-for="Title"
                               class="form-label fw-semibold">
                            Product Name
                        </label>

                        <input asp-for="Title"
                               class="form-control form-control-lg"
                               placeholder="Enter product name" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Price -->
                    <div class="col-md-6">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                            Price
                        </label>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control form-control-lg"
                               placeholder="Enter product price" />

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Quantity -->
                    <div class="col-md-6">

                        <label asp-for="Quantity"
                               class="form-label fw-semibold">
                            Quantity
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="0"
                               class="form-control form-control-lg"
                               placeholder="Enter product quantity" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Category -->
                    <div class="col-md-6">

                        <label asp-for="CategoryId"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select form-select-lg">

                            <option value="0">
                                Select Category
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Description -->
                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter product description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Product Image -->
                    <div class="col-12">

                        <label asp-for="Image"
                               class="form-label fw-semibold">
                            Change Product Image
                        </label>

                        <input asp-for="Image"
                               type="file"
                               class="form-control form-control-lg"
                               accept="image/*" />

                        <span asp-validation-for="Image"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Leave empty if you do not want to change the image.
                        </small>

                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-5">

                    <a asp-action="Index"
                       asp-controller="Product"
                       class="btn btn-light px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-5">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}